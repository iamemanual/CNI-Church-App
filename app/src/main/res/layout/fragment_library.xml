<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/windowBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Liturgical Books &amp; Service Orders"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Sacramental texts, communion liturgies, and daily prayers"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Book 1: Prabhu Bhoj -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_book_prabhu_bhoj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#0F1D38"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:strokeColor="#D4AF37"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The Lord's Supper (प्रभु भोज)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Order of the Lord's Supper &amp; Eucharistic Liturgy"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_open_prabhu_bhoj"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Open Liturgy Reader"
                    android:textColor="#D4AF37"
                    app:strokeColor="#D4AF37" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Book 2: Ashaye Rabbani -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_book_ashaye_rabbani"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#0F1D38"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The Desires of the Lord (अशाये रब्बानी)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ashaye Rabbani Communion Service Book"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_open_ashaye_rabbani"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Open Liturgy Reader"
                    android:textColor="#D4AF37"
                    app:strokeColor="#D4AF37" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Book 3: Aaradhanaa -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_book_aaradhanaa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#0F1D38"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Morning &amp; Evening Worship (प्रातःकालीन व सायंकालीन)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Daily Morning and Evening Prayer &amp; Liturgies"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_open_aaradhanaa"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Open Liturgy Reader"
                    android:textColor="#D4AF37"
                    app:strokeColor="#D4AF37" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Active Reader Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_active_reader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#0A1528"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="#38BDF8"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_reader_book_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The Lord's Supper • Eucharistic Liturgy"
                    android:textColor="#38BDF8"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_reader_page_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#030B18"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:text="Lord, have mercy upon us.\nChrist, have mercy upon us.\nLord, have mercy upon us.\n\nLet us pray for the Church Universal..."
                    android:textColor="#F1F5F9"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_reader_prev"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◀ Page"
                        android:textColor="#D4AF37" />

                    <TextView
                        android:id="@+id/tv_reader_page_indicator"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Page 1 of 42"
                        android:textAlignment="center"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_reader_next"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Page ▶"
                        android:textColor="#D4AF37" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
