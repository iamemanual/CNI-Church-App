<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#0F1D38"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="#1E293B"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_hymn_number"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="#D4AF37"
                android:gravity="center"
                android:text="1"
                android:textColor="#091428"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_hymn_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Holy, Holy, Holy! Lord God Almighty!"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_hymn_hindi_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="पवित्र, पवित्र, पवित्र, सर्वशक्तिमान प्रभु"
                    android:textColor="#FBBF24"
                    android:textSize="13sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btn_favorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_favorite_border" />

        </LinearLayout>

        <!-- Musical info & category -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_hymn_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1E3A8A"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="English Hymn"
                android:textColor="#93C5FD"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hymn_musical_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Key: E-flat Major • 4/4"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Preview verses -->
        <TextView
            android:id="@+id/tv_hymn_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="Holy, Holy, Holy! Lord God Almighty!\nEarly in the morning our song shall rise to Thee..."
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
